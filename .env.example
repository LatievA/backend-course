# Environment Variables for Workout Tracker

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/workout-tracker

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=3000

# CORS Configuration (use * for development, specific origin for production)
CORS_ORIGIN=*

# Admin Seed Credentials (used by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
